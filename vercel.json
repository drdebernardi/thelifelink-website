{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/privacy-policy",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/_files/ugd/d543a0_4e7d936a3ecc4f489c29bce47633ce13.pdf",
      "destination": "/assets/docs/notice-of-privacy-practices-en.pdf",
      "permanent": true
    },
    {
      "source": "/_files/ugd/d543a0_5a31da5b141c461b9aa36d5eaf315781.pdf",
      "destination": "/assets/docs/notice-of-privacy-practices-es.pdf",
      "permanent": true
    },
    {
      "source": "/about-us",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/our-history",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/our-team",
      "destination": "/about#leadership",
      "permanent": true
    },
    {
      "source": "/community-voices",
      "destination": "/about#testimonials",
      "permanent": true
    },
    {
      "source": "/you-tube-videos-1/:path*",
      "destination": "/about#testimonials",
      "permanent": true
    },
    {
      "source": "/contact-us",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/community-feedback",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/get-help-now",
      "destination": "/programs#get-help",
      "permanent": true
    },
    {
      "source": "/online-resources",
      "destination": "/programs#get-help",
      "permanent": true
    },
    {
      "source": "/guides-1/:path*",
      "destination": "/programs",
      "permanent": true
    },
    {
      "source": "/housing-support",
      "destination": "/programs/housing",
      "permanent": true
    },
    {
      "source": "/outreach-services",
      "destination": "/programs/outreach",
      "permanent": true
    },
    {
      "source": "/the-clubhouse",
      "destination": "/programs/clubhouse",
      "permanent": true
    },
    {
      "source": "/clubhouse-philosophy",
      "destination": "/programs/clubhouse",
