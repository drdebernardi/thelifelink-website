---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/inter/800.css';
import '@fontsource/dm-serif-display/400.css';
import '@fontsource/dm-serif-display/400-italic.css';
import Analytics from '@vercel/analytics/astro';
import { SITE } from '../data/site';
const { title, description, path = '/', image = '/assets/tll-logo.png', jsonLd, noindex = false } = Astro.props;
const url = SITE.url + (path === '/' ? '/' : path);
const img = image.startsWith('http') ? image : SITE.url + image;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={url}>
  {noindex && <meta name="robots" content="noindex, nofollow">}
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="The Life Link">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={url}>
  <meta property="og:image" content={img}>
  <meta name="twitter:card" content="summary_large_image">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="theme-color" content="#141f4d">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" href="/assets/tll-logo.png">
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  <style is:global>
    *{box-sizing:border-box;}
    body{margin:0;text-wrap:pretty;}
    /* Avoid a lone word on the last line: balance headings and short lines, "pretty" wrapping for body text. */
    h1,h2,h3,h4,h5,h6,blockquote,figcaption,dt,button{text-wrap:balance;}
    .tll-skip{position:absolute;left:-9999px;top:0;z-index:1000;background:#f5b829;color:#141f4d;font-family:Inter,sans-serif;font-weight:700;padding:10px 16px;}
    .tll-skip:focus{left:8px;top:8px;}
    @keyframes tllfloat{0%,100%{transform:translateY(0);}50%{transform:translateY(-8px);}}
    @keyframes tllrise{from{opacity:0;transform:translateY(22px);}to{opacity:1;transform:none;}}
    @media (prefers-reduced-motion: reduce){[data-reveal]{animation:none !important;}}
  </style>
</head>
<body>
  <a href="#main" class="tll-skip">Skip to main content</a>
  <slot />
  <script is:inline>
    // Gentle rise-in as sections scroll into view. Content is visible by default.
    (function () {
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce || !('IntersectionObserver' in window)) return;
      var els = Array.prototype.slice.call(document.querySelectorAll('[data-reveal]'));
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { if (e.isIntersecting) { e.target.style.animation = 'tllrise .7s ease both'; io.unobserve(e.target); } });
      }, { threshold: 0.08, rootMargin: '0px 0px -4% 0px' });
      els.forEach(function (el) { io.observe(el); });
    })();
  </script>
  <script is:inline>
    // No lone words: keep the last two words of each text block together, and keep
    // hyphenated words in short headings and labels whole, unless that would overflow.
    // Off in edit mode (#edit) so edit mode sees the plain text.
    (function () {
      if (/edit/.test(location.hash)) return;
      var NB = '\u00a0', WJ = '\u2060', items = [];
      function disp(el) { return getComputedStyle(el).display; }
      function collect() {
        var all = document.body.querySelectorAll('*');
        for (var i = 0; i < all.length; i++) {
          var el = all[i];
          if (/^(SCRIPT|STYLE|NOSCRIPT|INPUT|TEXTAREA|SELECT|OPTION|CODE|PRE)$/.test(el.tagName) || el.closest('svg')) continue;
          var d = disp(el); if (d === 'inline' || d === 'contents' || d === 'none') continue;
          var blockKid = false;
          for (var k = 0; k < el.children.length; k++) { var dk = disp(el.children[k]); if (dk !== 'inline' && dk !== 'none' && dk !== 'contents') { blockKid = true; break; } }
          if (blockKid) continue;
          var text = el.textContent.trim();
          if (!/\s/.test(text) && text.indexOf('-') < 0) continue;
          var tw = document.createTreeWalker(el, NodeFilter.SHOW_TEXT), n, last = null, nodes = [];
          while ((n = tw.nextNode())) { nodes.push(n); if (/\S/.test(n.nodeValue)) last = n; }
          items.push({ el: el, last: last, hy: text.length <= 60 ? nodes : [] });
        }
      }
      function setNb(it, on) {
        var n = it.last; if (!n) return; var v = n.nodeValue;
        var m = on ? /^([\s\S]*\S) (\S+\s*)$/.exec(v) : /^([\s\S]*\S)\u00a0(\S+\s*)$/.exec(v);
        if (m) n.nodeValue = m[1] + (on ? NB : ' ') + m[2];
      }
      function setWj(it, on) {
        it.hy.forEach(function (n) { var v = n.nodeValue, w = on ? v.replace(/(\w)-(?=\w)/g, '$1-' + WJ) : v.split(WJ).join(''); if (w !== v) n.nodeValue = w; });
      }
      function over(el) { return el.scrollWidth > el.clientWidth + 1; }
      function run() {
        items.forEach(function (it) {
          setNb(it, true); setWj(it, true);
          if (over(it.el)) { setWj(it, false); if (over(it.el)) { setNb(it, false); setWj(it, true); if (over(it.el)) setWj(it, false); } }
        });
      }
      function start() { collect(); run(); var t; window.addEventListener('resize', function () { clearTimeout(t); t = setTimeout(function () { items.forEach(function (it) { setNb(it, false); setWj(it, false); }); run(); }, 150); }); }
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start); else start();
    })();
  </script>
  <script is:inline src="/edit-mode.js" defer></script>
  <Analytics />
</body>
</html>
