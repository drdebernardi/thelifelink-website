---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
// The PDFs live in public/assets/docs/. To update, replace the files with the same names.
const docs = [
  { label: 'Notice of Privacy Practices (English)', href: '/assets/docs/notice-of-privacy-practices-en.pdf', lang: 'en' },
  { label: 'Aviso de Prácticas de Privacidad (Español)', href: '/assets/docs/notice-of-privacy-practices-es.pdf', lang: 'es' },
];
---
<Base title="Notice of Privacy Practices | The Life Link" description="The Life Link's Notice of Privacy Practices, in English and Spanish." path="/privacy">
<div style="font-family:'Inter',sans-serif;color:#1a2236;background:#ffffff;overflow-x:hidden;">
<Header active="" />
<main id="main">
<section style="max-width:820px;margin:0 auto;padding:72px 24px 88px;">
<div style="display:flex;align-items:center;gap:9px;margin-bottom:20px;">
<span style="width:22px;height:3px;background:#f5b829;border-radius:2px;"></span>
<span style="font-size:12px;letter-spacing:0.18em;text-transform:uppercase;color:#5b647a;font-weight:700;">Privacy</span>
</div>
<h1 style="font-family:'DM Serif Display',serif;font-size:clamp(36px,5vw,56px);line-height:1.08;margin:0 0 12px;color:#141f4d;font-weight:400;">Notice of Privacy Practices</h1>
<p lang="es" style="font-size:20px;color:#5b647a;margin:0 0 28px;">Aviso de Prácticas de Privacidad</p>
<p style="font-size:17px;line-height:1.65;color:#3d4660;margin:0 0 32px;">This notice describes how health information about you may be used and disclosed, and how you can get access to this information. Please review it carefully.</p>
<div style="display:flex;flex-wrap:wrap;gap:14px;">
{docs.map((d) => (
<a href={d.href} lang={d.lang} target="_blank" rel="noopener" style="background:#1e3278;color:#ffffff;font-weight:700;font-size:15.5px;text-decoration:none;padding:14px 26px;border-radius:4px;">{d.label} (PDF)</a>
))}
</div>
</section>
</main>
<Footer />
</div>
</Base>
