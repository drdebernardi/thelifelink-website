---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import data from '../data/impact.json';
const { linked, heroTiles, chain, needs, people, context, where, programs, also, panels, mix, times, sat, scores, kpis, survey, accred, audits, events, partners, ahead } = data;
---
<Base image="/assets/og/impact.jpg" title="Our Impact | The Life Link" description="See what The Life Link accomplished from July 2025 through June 2026 for homeless, at-risk, and exploited neighbors in Santa Fe." path="/impact">

<div style="font-family:'Inter',sans-serif;color:#1a2236;background:#ffffff;overflow-x:hidden;">
<Header active="impact" />
<main id="main">

<section style="background:#141f4d;color:#fff;position:relative;overflow:hidden;">
<svg width="760" height="760" viewBox="0 0 760 760" fill="none" aria-hidden="true" style="position:absolute;right:-200px;top:-140px;opacity:0.06;pointer-events:none;"><circle cx="380" cy="380" r="340" stroke="#fff" stroke-width="40"></circle><circle cx="380" cy="380" r="200" stroke="#fff" stroke-width="40"></circle></svg>
<div style="max-width:1200px;margin:0 auto;padding:80px 24px;display:flex;flex-wrap:wrap;gap:56px;align-items:center;position:relative;">
<div style="flex:1 1 440px;min-width:300px;" data-reveal>
<div style="display:flex;align-items:center;gap:9px;margin-bottom:20px;">
<span style="width:22px;height:3px;background:#f5b829;border-radius:2px;"></span>
<span style="font-size:12px;letter-spacing:0.18em;text-transform:uppercase;color:#a9b7e0;font-weight:700;">Impact Report · Fiscal Year 2026</span>
</div>
<h1 style="font-family:'DM Serif Display',serif;font-size:clamp(42px,5.5vw,66px);line-height:1.05;margin:0 0 24px;font-weight:400;">A Year of Links<br />That <span style="color:#f5b829;font-style:italic;">Held.</span></h1>
<p style="font-size:17.5px;line-height:1.7;color:#c9d2ea;max-width:500px;margin:0 0 34px;">From July 2025 through June 2026, The Life Link met Santa Fe's most vulnerable neighbors where they were — on the street, in crisis, coming home from incarceration, escaping exploitation — and connected each one to housing, care, and recovery.</p>
<div style="display:flex;flex-wrap:wrap;gap:13px;">
<a href="#programs" style="background:#2ab5a0;color:#141f4d;font-weight:600;font-size:16px;text-decoration:none;padding:15px 26px;border-radius:4px;">See the numbers</a>
<a href="#give" style="background:transparent;color:#fff;font-weight:600;font-size:16px;text-decoration:none;padding:14px 26px;border-radius:4px;border:1px solid rgba(255,255,255,0.35);">Forge the next link</a>
</div>
</div>
<div style="flex:1 1 420px;min-width:300px;display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:16px;" data-reveal>
{heroTiles.map((t, t_i) => (<Fragment>
<div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:14px;padding:24px 22px;">
<svg width="40" height="40" viewBox="0 0 44 44" fill="none" aria-hidden="true"><circle cx="22" cy="22" r="19" stroke={t.c} stroke-width="3.5"></circle><circle cx="22" cy="22" r="8" fill={t.c} opacity="0.25"></circle></svg>
<div style={`font-family:'DM Serif Display',serif;font-size:clamp(36px,3.6vw,46px);line-height:1;margin:14px 0 8px;color:${t.c};`}>{t.num}<span style="font-size:0.5em;opacity:0.8;">{t.suffix}</span></div>
<div style="font-size:13.5px;line-height:1.5;color:#c9d2ea;">{t.txt}</div>
</div>
</Fragment>))}
</div>
</div>
</section>

<div style="background:#141f4d;border-top:1px solid rgba(255,255,255,0.08);" aria-hidden="true">
<div style="max-width:1200px;margin:0 auto;padding:22px 24px;display:flex;align-items:center;justify-content:center;gap:12px;flex-wrap:wrap;">
{chain.map((n, n_i) => (<Fragment>
<div style="display:flex;align-items:center;gap:12px;">
<div style="display:flex;align-items:center;gap:10px;">
<svg width="28" height="28" viewBox="0 0 44 44" fill="none"><circle cx="22" cy="22" r="18" stroke={n.c} stroke-width="3.5"></circle></svg>
<span style="font-size:11px;letter-spacing:0.14em;font-weight:700;text-transform:uppercase;color:#a9b7e0;white-space:nowrap;">{n.label}</span>
</div>
{n.link ? (<Fragment>
<svg width="44" height="12" viewBox="0 0 44 12" fill="none"><rect x="1" y="1" width="20" height="10" rx="5" stroke="rgba(255,255,255,0.28)" stroke-width="2"></rect><rect x="23" y="1" width="20" height="10" rx="5" stroke="rgba(255,255,255,0.28)" stroke-width="2"></rect></svg>
</Fragment>) : null}
</div>
</Fragment>))}
</div>
</div>

<section style="max-width:1200px;margin:0 auto;padding:84px 24px;">
<div style="text-align:center;max-width:680px;margin:0 auto 48px;" data-reveal>
<div style="display:flex;align-items:center;gap:9px;margin-bottom:16px;justify-content:center;">
<span style="width:22px;height:3px;background:#f5b829;border-radius:2px;"></span>
<span style="font-size:12px;letter-spacing:0.18em;text-transform:uppercase;color:#5b647a;font-weight:700;">Who We Serve</span>
</div>
<h2 style="font-family:'DM Serif Display',serif;font-size:clamp(32px,4vw,46px);line-height:1.1;margin:0 0 14px;color:#141f4d;font-weight:400;">The People Other Systems Couldn't Reach</h2>
<p style="font-size:17px;line-height:1.65;color:#5b647a;margin:0;">Our clients arrive carrying more than one burden at once. That is exactly why every service at The Life Link is linked to the next — no one has to start over at a new front door.</p>
</div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:20px;">
{needs.map((n, n_i) => (<Fragment>
<div data-reveal style={`background:#fff;border:1px solid #e4ebf4;border-top:4px solid ${n.c};border-radius:14px;padding:30px 24px;text-align:center;`}>
<svg width="112" height="112" viewBox="0 0 120 120" role="img" aria-label={n.big} style="display:block;margin:0 auto 16px;"><circle cx="60" cy="60" r="50" fill="none" stroke="#eef2f8" stroke-width="12"></circle><circle cx="60" cy="60" r="50" fill="none" stroke={n.c} stroke-width="12" stroke-linecap="round" stroke-dasharray={n.dash} transform="rotate(-90 60 60)"></circle><text x="60" y="69" text-anchor="middle" font-family="DM Serif Display, serif" font-size={n.fs} fill="#141f4d">{n.big}</text></svg>
<h3 style="font-family:'DM Serif Display',serif;font-size:21px;font-weight:400;color:#141f4d;line-height:1.25;margin:0 0 10px;">{n.title}</h3>
<p style="font-size:14px;line-height:1.6;color:#5b647a;margin:0;">{n.body}</p>
</div>
</Fragment>))}
</div>
<div style="margin-top:20px;background:#f4f7fb;border-radius:14px;display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));" data-reveal>
{people.map((p, p_i) => (<Fragment>
<div style="padding:24px;">
<div style="font-family:'DM Serif Display',serif;font-size:32px;color:#1e3278;line-height:1.1;margin-bottom:6px;">{p.num}</div>
<div style="font-size:13.5px;color:#5b647a;line-height:1.5;">{p.txt}</div>
</div>
</Fragment>))}
</div>
<p style="font-size:12px;color:#5b647a;line-height:1.5;text-align:center;margin:18px auto 0;max-width:820px;">* Percentages based on clients who reported this information at enrollment. Source: The Life Link Annual Quality Improvement Report, FY2026 (July 1, 2025 – June 30, 2026).</p>
</section>

<section style="background:#f4f7fb;">
<div style="max-width:1200px;margin:0 auto;padding:84px 24px;">
<div style="text-align:center;max-width:680px;margin:0 auto 48px;" data-reveal>
<div style="display:flex;align-items:center;gap:9px;margin-bottom:16px;justify-content:center;">
<span style="width:22px;height:3px;background:#f5b829;border-radius:2px;"></span>
<span style="font-size:12px;letter-spacing:0.18em;text-transform:uppercase;color:#5b647a;font-weight:700;">Why It Matters Here</span>
</div>
<h2 style="font-family:'DM Serif Display',serif;font-size:clamp(32px,4vw,46px);line-height:1.1;margin:0 0 14px;color:#141f4d;font-weight:400;">New Mexico Needs This Chain to Hold</h2>
<p style="font-size:17px;line-height:1.65;color:#5b647a;margin:0;">Poverty, distance, and exploitation compound one another across northern New Mexico. The Life Link was built for exactly these conditions.</p>
</div>
<div style="display:flex;flex-wrap:wrap;gap:24px;align-items:stretch;">
<div data-reveal style="flex:1 1 420px;min-width:290px;background:#141f4d;color:#fff;border-radius:16px;padding:40px 36px;">
<div style="font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#f5b829;font-weight:700;">Poverty · 2023</div>
<div style="font-family:'DM Serif Display',serif;font-size:clamp(72px,9vw,110px);line-height:0.9;color:#f5b829;margin-top:14px;">3<sup style="font-size:0.35em;vertical-align:top;position:relative;top:0.5em;margin-left:4px;">rd</sup></div>
<h3 style="font-family:'DM Serif Display',serif;font-weight:400;font-size:26px;line-height:1.25;margin:16px 0 12px;">highest poverty rate in the nation</h3>
<p style="font-size:15px;line-height:1.7;color:#c9d2ea;margin:0 0 26px;">Roughly 368,669 New Mexicans live in poverty. For the people who walk through our doors, poverty is rarely the only burden they carry.</p>
<div role="img" aria-label="Poverty rate in 2023: New Mexico 17.8 percent, United States 12.5 percent" style="display:flex;flex-direction:column;gap:10px;">
<div style="display:grid;grid-template-columns:110px 1fr 52px;gap:12px;align-items:center;font-size:13px;color:#c9d2ea;"><span>New Mexico</span><div style="height:12px;background:rgba(255,255,255,0.1);border-radius:6px;overflow:hidden;"><div style="width:89%;height:100%;background:#f5b829;border-radius:6px;"></div></div><b style="color:#fff;text-align:right;">17.8%</b></div>
<div style="display:grid;grid-template-columns:110px 1fr 52px;gap:12px;align-items:center;font-size:13px;color:#c9d2ea;"><span>United States</span><div style="height:12px;background:rgba(255,255,255,0.1);border-radius:6px;overflow:hidden;"><div style="width:62.5%;height:100%;background:rgba(255,255,255,0.4);border-radius:6px;"></div></div><b style="color:#fff;text-align:right;">12.5%</b></div>
</div>
</div>
<div style="flex:1 1 380px;min-width:290px;display:flex;flex-direction:column;gap:14px;">
{context.map((c, c_i) => (<Fragment>
<div data-reveal style={`background:#fff;border:1px solid #e4ebf4;border-left:4px solid ${c.c};border-radius:12px;padding:20px 22px;display:flex;gap:20px;align-items:center;`}>
<div style="font-family:'DM Serif Display',serif;font-size:34px;color:#1e3278;line-height:1;min-width:84px;">{c.num}</div>
<div style="font-size:14.5px;line-height:1.55;color:#3a4256;">{c.txt}</div>
</div>
</Fragment>))}
</div>
</div>
<p style="font-size:12px;color:#5b647a;line-height:1.5;margin:22px 0 0;">Isolated pueblos in central and northern New Mexico are disproportionately affected by missing and murdered Indigenous women tied to trafficking. Sources: The Life Link Human Trafficking Outreach &amp; Aftercare Outcomes Reference (2015–2025).</p>
</div>
</section>

<section style="background:#1e3278;color:#fff;">
<div style="max-width:1200px;margin:0 auto;padding:84px 24px;">
<div style="text-align:center;margin-bottom:52px;" data-reveal>
<div style="display:flex;align-items:center;gap:9px;margin-bottom:16px;justify-content:center;">
<span style="width:22px;height:3px;background:#f5b829;border-radius:2px;"></span>
<span style="font-size:12px;letter-spacing:0.18em;text-transform:uppercase;color:#a9b7e0;font-weight:700;">Linked Impact</span>
</div>
<h2 style="font-family:'DM Serif Display',serif;font-size:clamp(32px,4vw,46px);margin:0;font-weight:400;">Every link in the chain counts.</h2>
</div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:40px 28px;">
{linked.map((s, s_i) => (<Fragment>
<div style="position:relative;">
<div data-reveal style="text-align:center;">
<svg width="56" height="56" viewBox="0 0 56 56" fill="none" aria-hidden="true" style="display:block;margin:0 auto;"><circle cx="28" cy="28" r="24" stroke={s.c} stroke-width="3.5"></circle><circle cx="28" cy="28" r="6" fill={s.c}></circle></svg>
<div style={`font-family:'DM Serif Display',serif;font-size:clamp(46px,5vw,62px);line-height:1;margin:18px 0 12px;color:${s.c};`}>{s.num}</div>
<div style="font-size:14.5px;line-height:1.55;color:#c9d2ea;max-width:230px;margin:0 auto;">{s.txt}</div>
</div>
{s.link ? (<Fragment>
<svg class="tll-chainlink" width="80" height="14" viewBox="0 0 80 14" fill="none" aria-hidden="true" style="position:absolute;right:-54px;top:21px;"><rect x="1" y="2" width="38" height="10" rx="5" stroke="rgba(255,255,255,0.35)" stroke-width="2"></rect><rect x="41" y="2" width="38" height="10" rx="5" stroke="rgba(245,184,41,0.6)" stroke-width="2"></rect></svg>
</Fragment>) : null}
</div>
</Fragment>))}
</div>
<div style="margin-top:64px;padding-top:52px;border-top:1px solid rgba(255,255,255,0.14);display:flex;flex-wrap:wrap;gap:48px;align-items:center;" data-reveal>
<div style="flex:1 1 320px;min-width:280px;">
<div style="font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#f5b829;font-weight:700;">Care That Travels</div>
<h3 style="font-family:'DM Serif Display',serif;font-weight:400;font-size:30px;line-height:1.2;margin:12px 0 14px;">We go to where people are.</h3>
<p style="font-size:15.5px;line-height:1.7;color:#c9d2ea;margin:0;">More than half of our community support visits happen outside the office. For someone living in an arroyo or a car, that is often the difference between getting care and going without.</p>
</div>
<div style="flex:1.4 1 400px;min-width:280px;display:flex;flex-direction:column;gap:18px;" role="img" aria-label="Where community support services took place: other community locations 35 percent, office 31 percent, client's home 18 percent, telehealth 16 percent">
{where.map((w, w_i) => (<Fragment>
<div>
<div style="display:flex;justify-content:space-between;font-size:13.5px;color:#c9d2ea;margin-bottom:7px;"><span>{w.label}</span><b style="color:#fff;">{w.pct}</b></div>
<div style="height:10px;background:rgba(255,255,255,0.1);border-radius:5px;overflow:hidden;"><div style={`height:100%;border-radius:5px;width:${w.pct};background:${w.c};`}></div></div>
</div>
</Fragment>))}
</div>
</div>
</div>
</section>

<section id="programs" style="max-width:1200px;margin:0 auto;padding:84px 24px;scroll-margin-top:120px;">
<div style="text-align:center;max-width:680px;margin:0 auto 48px;" data-reveal>
<div style="display:flex;align-items:center;gap:9px;margin-bottom:16px;justify-content:center;">
<span style="width:22px;height:3px;background:#f5b829;border-radius:2px;"></span>
<span style="font-size:12px;letter-spacing:0.18em;text-transform:uppercase;color:#5b647a;font-weight:700;">Four Links · One Chain</span>
</div>
<h2 style="font-family:'DM Serif Display',serif;font-size:clamp(32px,4vw,46px);line-height:1.1;margin:0 0 14px;color:#141f4d;font-weight:400;">What Your Support Made Possible</h2>
<p style="font-size:17px;line-height:1.65;color:#5b647a;margin:0;">Each program is its own lifeline. Together they form a chain of support that no single crisis can break.</p>
</div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:20px;">
{programs.map((p, p_i) => (<Fragment>
<article data-reveal style="border:1px solid #e4ebf4;border-radius:16px;overflow:hidden;display:flex;flex-direction:column;background:#fff;">
<div style={`background:${p.c};color:#141f4d;padding:26px 24px 22px;position:relative;overflow:hidden;`}>
<span aria-hidden="true" class="tile-num" data-n={p.n} style="position:absolute;right:16px;top:10px;font-family:'DM Serif Display',serif;font-size:52px;opacity:0.2;line-height:1;"></span>
<h3 style="font-family:'DM Serif Display',serif;font-weight:400;font-size:23px;line-height:1.2;margin:0;padding-right:56px;">{p.title}</h3>
<div style="font-family:'DM Serif Display',serif;font-size:46px;line-height:1;margin-top:18px;">{p.big}</div>
<div style="font-size:13.5px;margin-top:6px;line-height:1.45;">{p.sub}</div>
</div>
<ul style="list-style:none;padding:20px 24px 26px;margin:0;display:flex;flex-direction:column;gap:13px;flex:1;">
{p.items.map((it, it_i) => (<Fragment>
<li style="display:flex;gap:11px;align-items:flex-start;font-size:14px;line-height:1.5;color:#3a4256;">
<span style={`flex-shrink:0;width:9px;height:9px;border-radius:50%;border:2px solid ${p.c};margin-top:6px;`}></span>
<span><b style="color:#141f4d;font-weight:700;">{it.b}</b> {it.t}</span>
</li>
</Fragment>))}
</ul>
</article>
</Fragment>))}
</div>
<div style="margin-top:20px;display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px;">
{also.map((a, a_i) => (<Fragment>
<div data-reveal style="border:1px solid #e4ebf4;border-radius:12px;padding:22px 24px;display:flex;gap:18px;align-items:baseline;">
<strong style="font-family:'DM Serif Display',serif;font-weight:400;font-size:34px;color:#1e3278;line-height:1;flex-shrink:0;">{a.num}</strong>
<span style="font-size:14px;color:#5b647a;line-height:1.5;">{a.txt}</span>
</div>
</Fragment>))}
</div>
</section>

<section style="background:#f4f7fb;">
<div style="max-width:1200px;margin:0 auto;padding:84px 24px;">
<div style="text-align:center;max-width:680px;margin:0 auto 48px;" data-reveal>
<div style="display:flex;align-items:center;gap:9px;margin-bottom:16px;justify-content:center;">
<span style="width:22px;height:3px;background:#f5b829;border-radius:2px;"></span>
<span style="font-size:12px;letter-spacing:0.18em;text-transform:uppercase;color:#5b647a;font-weight:700;">Inside the Work</span>
</div>
<h2 style="font-family:'DM Serif Display',serif;font-size:clamp(32px,4vw,46px);line-height:1.1;margin:0 0 14px;color:#141f4d;font-weight:400;">A Closer Look at a Year of Care</h2>
<p style="font-size:17px;line-height:1.65;color:#5b647a;margin:0;">Behind the headline numbers: the services people used most, how they received them, and how much time our staff spent at their side.</p>
</div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,440px),1fr));gap:24px;">
{panels.map((pn, pn_i) => (<Fragment>
<div data-reveal style="background:#fff;border:1px solid #e4ebf4;border-radius:16px;padding:34px 30px;">
<div style="font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#1e8374;font-weight:700;">{pn.label}</div>
<h3 style="font-family:'DM Serif Display',serif;font-weight:400;font-size:26px;color:#141f4d;margin:10px 0 8px;line-height:1.2;">{pn.title}</h3>
<p style="font-size:14.5px;color:#5b647a;line-height:1.6;margin:0 0 24px;">{pn.body}</p>
<div style="display:flex;flex-direction:column;gap:11px;">
{pn.rows.map((r, r_i) => (<Fragment>
<div style="display:grid;grid-template-columns:minmax(110px,170px) 1fr 58px;gap:12px;align-items:center;">
<span style="font-size:13px;color:#1a2236;line-height:1.3;">{r.l}{r.s ? (<Fragment><small style="display:block;font-size:11.5px;color:#5b647a;">{r.s}</small></Fragment>) : null}</span>
<div style="height:14px;background:#eef2f8;border-radius:4px;overflow:hidden;"><div style={`height:100%;border-radius:4px;width:${r.w};background:${r.c};`}></div></div>
<span style="font-family:'DM Serif Display',serif;font-size:17px;color:#1e3278;text-align:right;">{r.v}</span>
</div>
</Fragment>))}
</div>
{pn.note ? (<Fragment>
<p style="margin:16px 0 0;font-size:12.5px;color:#5b647a;line-height:1.5;">{pn.note}</p>
</Fragment>) : null}
</div>
</Fragment>))}
</div>
<div data-reveal style="margin-top:24px;background:#fff;border:1px solid #e4ebf4;border-radius:16px;padding:34px 30px;">
<div style="font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#1e8374;font-weight:700;">How Care Is Delivered</div>
<h3 style="font-family:'DM Serif Display',serif;font-weight:400;font-size:26px;color:#141f4d;margin:10px 0 8px;line-height:1.2;">Face to face first, with telehealth where it helps</h3>
<p style="font-size:14.5px;color:#5b647a;line-height:1.6;margin:0 0 24px;">88% of all services were delivered in person. Telehealth fills gaps — especially for psychiatry, where distance and transportation are real barriers.</p>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));gap:16px 40px;">
{mix.map((m, m_i) => (<Fragment>
<div>
<div style="display:flex;justify-content:space-between;gap:10px;font-size:13.5px;color:#1a2236;margin-bottom:6px;"><span>{m.l}</span><span style="color:#5b647a;font-size:12.5px;">{m.note}</span></div>
<div style="display:flex;height:16px;border-radius:4px;overflow:hidden;">
{m.segs.map((sg, sg_i) => (<Fragment><i style={`display:block;height:100%;width:${sg.w};background:${sg.c};`}></i></Fragment>))}
</div>
</div>
</Fragment>))}
</div>
<div style="display:flex;gap:18px;flex-wrap:wrap;margin-top:16px;font-size:12.5px;color:#5b647a;">
<span style="display:flex;align-items:center;gap:6px;"><i style="width:10px;height:10px;border-radius:2px;background:#2ab5a0;display:block;"></i>Community locations</span>
<span style="display:flex;align-items:center;gap:6px;"><i style="width:10px;height:10px;border-radius:2px;background:#7dc242;display:block;"></i>Client's home</span>
<span style="display:flex;align-items:center;gap:6px;"><i style="width:10px;height:10px;border-radius:2px;background:#3a8fd4;display:block;"></i>Our offices</span>
