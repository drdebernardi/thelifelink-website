---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import data from '../data/about.json';
const { events, execs, leaders, stories, staff, board } = data;
---
<Base image="/assets/og/about.jpg" title="About The Life Link | Our Story, Board & Leadership" description="For almost 40 years, The Life Link has met people at their hardest moments and walked alongside them toward something better. Meet our board, leadership, and partners." path="/about">

<div style="font-family:'Inter',sans-serif;color:#1a2236;background:#ffffff;overflow-x:hidden;">
<Header active="about" />
<main id="main">

<section id="who-we-are" style="background:#141f4d;color:#ffffff;position:relative;overflow:hidden;scroll-margin-top:120px;">
<svg width="760" height="760" viewBox="0 0 760 760" fill="none" aria-hidden="true" style="position:absolute;left:-260px;top:-180px;opacity:0.06;pointer-events:none;"><circle cx="380" cy="380" r="340" stroke="#fff" stroke-width="40"></circle><circle cx="380" cy="380" r="200" stroke="#fff" stroke-width="40"></circle></svg>
<div style="max-width:1200px;margin:0 auto;padding:80px 24px;display:flex;flex-wrap:wrap;gap:56px;align-items:center;position:relative;">
<div style="flex:1 1 440px;min-width:320px;" data-reveal>
<div style="display:flex;align-items:center;gap:9px;margin-bottom:20px;">
<span style="width:22px;height:3px;background:#f5b829;border-radius:2px;"></span>
<span style="font-size:12px;letter-spacing:0.18em;text-transform:uppercase;color:#a9b7e0;font-weight:700;">Who We Are</span>
</div>
<h1 style="font-family:'DM Serif Display',serif;font-size:clamp(40px,5.5vw,64px);line-height:1.05;margin:0 0 24px;color:#ffffff;font-weight:400;">The link between where you are and <span style="color:#f5b829;font-style:italic;">where you're going.</span></h1>
<p style="font-size:18.5px;line-height:1.65;color:#ffffff;margin:0 0 20px;">For almost 40 years, The Life Link has met people at their hardest moments — and walked alongside them toward something better. Every person deserves a path forward and that path starts here.</p>
<p style="font-size:16.5px;line-height:1.7;color:#c9d2ea;margin:0 0 20px;">With different, yet often overlapping needs - housing, mental health, addiction, human trafficking aftercare – one connection can change everything and be the link to new possibilities.</p>
<p style="font-size:16.5px;line-height:1.7;color:#c9d2ea;margin:0;">The Life Link’s work has drawn national attention, featured by <strong style="color:#f5b829;">BBC</strong>, <strong style="color:#f5b829;">Esquire</strong>, and regional press.</p>
</div>
<div style="flex:1 1 380px;min-width:300px;" data-reveal>
<img src="/assets/photos/12_group_support.jpg" alt="A peer support group sharing and smiling together" style="display:block;width:100%;aspect-ratio:4/4.2;object-fit:cover;border-radius:18px;box-shadow:0 30px 60px -22px rgba(0,0,0,0.55);" />
</div>
</div>
</section>

<section id="board" style="background:#e6f3f4;scroll-margin-top:120px;">
<div style="max-width:1200px;margin:0 auto;padding:80px 24px;">
<div style="text-align:center;max-width:640px;margin:0 auto 48px;" data-reveal>
<div style="display:flex;align-items:center;gap:9px;margin-bottom:16px;justify-content:center;">
<span style="width:22px;height:3px;background:#f5b829;border-radius:2px;"></span>
<span style="font-size:12px;letter-spacing:0.18em;text-transform:uppercase;color:#5b647a;font-weight:700;">Board of Directors</span>
</div>
<h2 style="font-family:'DM Serif Display',serif;font-size:clamp(32px,4vw,46px);margin:0;color:#141f4d;font-weight:400;">Guiding our mission.</h2>
</div>
<div style="display:flex;flex-wrap:wrap;justify-content:center;gap:16px;align-items:flex-start;">
{board.map((b, b_i) => (<Fragment>
<article class="bio-card" data-reveal style={`flex:1 1 150px;max-width:240px;min-width:0;background:#ffffff;border-radius:16px;overflow:hidden;border-top:4px solid ${b.c};box-shadow:0 18px 40px -28px rgba(30,50,120,0.45);`}>
<div style="display:flex;flex-direction:column;gap:10px;align-items:flex-start;padding:18px 18px 0;">
<div role="img" aria-label={b.name} style={`width:64px;height:64px;flex-shrink:0;border-radius:50%;border:3px solid ${b.c};background-color:#eef2f8;background-image:${b.bgImg};background-size:cover;background-position:${b.pos};`}></div>
<div>
<h3 style="font-family:'DM Serif Display',serif;font-weight:400;font-size:19px;line-height:1.2;color:#141f4d;margin:0;overflow-wrap:break-word;">{b.name}</h3>
<div style={`font-size:10.5px;letter-spacing:0.1em;text-transform:uppercase;font-weight:700;color:${b.roleColor};margin-top:5px;`}>{b.role}</div>
</div>
</div>
<div style="padding:14px 18px 18px;">
{b.bio.map((para, i) => (<p class={i === 0 ? 'bio-p' : 'bio-p bio-more'} style="font-size:13.5px;line-height:1.6;color:#3a4256;margin:0 0 10px;">{para}</p>))}
<button type="button" data-bio-toggle aria-expanded="false" style="background:none;border:none;padding:0;cursor:pointer;font-family:inherit;font-size:14px;font-weight:700;color:#1e3278;"><span class="bio-open">Read full bio →</span><span class="bio-close">Show less ↑</span></button>
</div>
</article>
</Fragment>))}
</div>
</div>
</section>

<section id="leadership" style="max-width:1200px;margin:0 auto;padding:80px 24px;scroll-margin-top:120px;">
<div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:20px 40px;margin-bottom:40px;" data-reveal>
<div style="max-width:620px;">
<div style="display:flex;align-items:center;gap:9px;margin-bottom:16px;">
<span style="width:22px;height:3px;background:#f5b829;border-radius:2px;"></span>
<span style="font-size:12px;letter-spacing:0.18em;text-transform:uppercase;color:#5b647a;font-weight:700;">Senior Leadership</span>
</div>
<h2 style="font-family:'DM Serif Display',serif;font-size:clamp(32px,4vw,46px);line-height:1.1;margin:0 0 12px;color:#141f4d;font-weight:400;">People at the heart of our work.</h2>
<p style="font-size:16.5px;line-height:1.6;color:#5b647a;margin:0;">Licensed clinicians, case managers, peer specialists, and outreach staff — a team that shows up every day.</p>
</div>
<div style="background:#1e3278;color:#ffffff;border-radius:14px;padding:20px 24px;display:flex;gap:16px;align-items:center;max-width:380px;">
<span style="font-family:'DM Serif Display',serif;font-size:46px;color:#f5b829;line-height:1;">94%</span>
<span style="font-size:14px;line-height:1.45;color:#dce3f5;">of our community support and Clubhouse staff bring lived experience to the work</span>
</div>
</div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr));gap:22px;margin-bottom:22px;">
{execs.map((x, x_i) => (<Fragment>
<div data-reveal style="background:#141f4d;color:#ffffff;border-radius:16px;padding:28px 30px;display:flex;gap:22px;align-items:center;position:relative;overflow:hidden;">
<svg width="220" height="220" viewBox="0 0 220 220" fill="none" aria-hidden="true" style="position:absolute;right:-70px;top:-70px;opacity:0.08;"><circle cx="110" cy="110" r="90" stroke="#ffffff" stroke-width="22"></circle><circle cx="110" cy="110" r="40" stroke="#ffffff" stroke-width="22"></circle></svg>
{x.photo ? (<Fragment>
<div role="img" aria-label={x.name} style={`width:96px;height:96px;flex-shrink:0;border-radius:50%;border:3px solid #f5b829;background-color:#1e3278;background-image:${x.bgImg};background-size:cover;background-position:center;position:relative;`}></div>
</Fragment>) : null}
{x.noPhoto ? (<Fragment>
<div style="width:76px;height:76px;flex-shrink:0;border-radius:50%;border:3px solid #f5b829;display:flex;align-items:center;justify-content:center;font-family:'DM Serif Display',serif;font-size:28px;color:#f5b829;position:relative;">{x.initials}</div>
</Fragment>) : null}
<div style="position:relative;">
<div style="font-size:12px;letter-spacing:0.14em;text-transform:uppercase;font-weight:700;color:#f5b829;margin-bottom:6px;">{x.title}</div>
<div style="font-family:'DM Serif Display',serif;font-size:26px;line-height:1.2;">{x.name}</div>
<div style="font-size:14px;color:#a9b7e0;margin-top:4px;">{x.cred}</div>
</div>
</div>
</Fragment>))}
</div>
<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,230px),1fr));gap:18px;">
{leaders.map((p, p_i) => (<Fragment>
<div data-reveal style={`background:#ffffff;border:1px solid #e4ebf4;border-top:4px solid ${p.c};border-radius:14px;padding:22px 22px 24px;display:flex;flex-direction:column;gap:14px;`}>
<div style={`width:52px;height:52px;border-radius:50%;background:${p.tint};display:flex;align-items:center;justify-content:center;font-family:'DM Serif Display',serif;font-size:20px;color:${p.c};`}>{p.initials}</div>
<div>
<div style={`font-size:11.5px;letter-spacing:0.1em;text-transform:uppercase;font-weight:700;color:${p.c};line-height:1.4;margin-bottom:6px;`}>{p.title}</div>
<div style="font-size:17px;font-weight:700;color:#141f4d;line-height:1.3;">{p.name}</div>
<div style="font-size:13.5px;color:#5b647a;margin-top:3px;">{p.cred}</div>
</div>
</div>
</Fragment>))}
</div>
<div style="margin-top:28px;display:flex;flex-wrap:wrap;gap:14px 24px;align-items:center;" data-reveal>
<span style="font-size:15px;color:#5b647a;">To reach any team member, call our main line or send us a message.</span>
<a href="/contact" style="display:inline-flex;align-items:center;gap:8px;background:#1e3278;color:#ffffff;font-weight:600;font-size:14.5px;text-decoration:none;padding:12px 22px;border-radius:4px;">Contact our team →</a>
</div>
</section>

<section id="partners" style="background:#ffffff;scroll-margin-top:120px;">
<div style="max-width:1200px;margin:0 auto;padding:80px 24px;">
<div style="text-align:center;max-width:640px;margin:0 auto 44px;" data-reveal>
<div style="display:flex;align-items:center;gap:9px;margin-bottom:16px;justify-content:center;">
<span style="width:22px;height:3px;background:#f5b829;border-radius:2px;"></span>
<span style="font-size:12px;letter-spacing:0.18em;text-transform:uppercase;color:#5b647a;font-weight:700;">Partners</span>
</div>
<h2 style="font-family:'DM Serif Display',serif;font-size:clamp(32px,4vw,46px);line-height:1.1;margin:0 0 12px;color:#141f4d;font-weight:400;">Stronger together.</h2>
<p style="font-size:16.5px;line-height:1.6;color:#5b647a;margin:0;">City, state, and federal agencies, foundations, and community organizations that make our work possible.</p>
</div>
<div data-reveal style="background:#ffffff;border:1px solid #e4ebf4;border-top:4px solid #2ab5a0;border-radius:16px;padding:34px 36px;max-width:1000px;margin:0 auto;">
<div style="font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#1d8575;font-weight:700;">Stronger Together</div>
<h3 style="font-family:'DM Serif Display',serif;font-weight:400;font-size:28px;color:#141f4d;margin:10px 0 18px;">Coalitions, boards, and workgroups</h3>
<ul style="list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));column-gap:36px;">
<li style="display:flex;gap:12px;align-items:flex-start;font-size:15px;line-height:1.45;color:#1a2236;padding:12px 0;border-bottom:1px solid #e4ebf4;"><span style="flex-shrink:0;width:8px;height:8px;border-radius:50%;background:#2ab5a0;margin-top:7px;"></span><span>NM Coalition to End Homelessness</span></li>
<li style="display:flex;gap:12px;align-items:flex-start;font-size:15px;line-height:1.45;color:#1a2236;padding:12px 0;border-bottom:1px solid #e4ebf4;"><span style="flex-shrink:0;width:8px;height:8px;border-radius:50%;background:#2ab5a0;margin-top:7px;"></span><span>Built for Zero</span></li>
<li style="display:flex;gap:12px;align-items:flex-start;font-size:15px;line-height:1.45;color:#1a2236;padding:12px 0;border-bottom:1px solid #e4ebf4;"><span style="flex-shrink:0;width:8px;height:8px;border-radius:50%;background:#2ab5a0;margin-top:7px;"></span><span>NM Behavioral Health Providers Association Board</span></li>
<li style="display:flex;gap:12px;align-items:flex-start;font-size:15px;line-height:1.45;color:#1a2236;padding:12px 0;border-bottom:1px solid #e4ebf4;"><span style="flex-shrink:0;width:8px;height:8px;border-radius:50%;background:#2ab5a0;margin-top:7px;"></span><span>Santa Fe County Behavioral Health Leadership Team</span></li>
<li style="display:flex;gap:12px;align-items:flex-start;font-size:15px;line-height:1.45;color:#1a2236;padding:12px 0;border-bottom:1px solid #e4ebf4;"><span style="flex-shrink:0;width:8px;height:8px;border-radius:50%;background:#2ab5a0;margin-top:7px;"></span><span>Housing Leadership Group of NM</span></li>
<li style="display:flex;gap:12px;align-items:flex-start;font-size:15px;line-height:1.45;color:#1a2236;padding:12px 0;border-bottom:1px solid #e4ebf4;"><span style="flex-shrink:0;width:8px;height:8px;border-radius:50%;background:#2ab5a0;margin-top:7px;"></span><span>Santa Fe Affordable Housing Action Coalition</span></li>
<li style="display:flex;gap:12px;align-items:flex-start;font-size:15px;line-height:1.45;color:#1a2236;padding:12px 0;border-bottom:1px solid #e4ebf4;"><span style="flex-shrink:0;width:8px;height:8px;border-radius:50%;background:#2ab5a0;margin-top:7px;"></span><span>City of Santa Fe Micro-Communities</span></li>
<li style="display:flex;gap:12px;align-items:flex-start;font-size:15px;line-height:1.45;color:#1a2236;padding:12px 0;border-bottom:1px solid #e4ebf4;"><span style="flex-shrink:0;width:8px;height:8px;border-radius:50%;background:#2ab5a0;margin-top:7px;"></span><span>Santa Fe County CONNECT</span></li>
<li style="display:flex;gap:12px;align-items:flex-start;font-size:15px;line-height:1.45;color:#1a2236;padding:12px 0;border-bottom:1px solid #e4ebf4;"><span style="flex-shrink:0;width:8px;height:8px;border-radius:50%;background:#2ab5a0;margin-top:7px;"></span><span>Partnerships for Success Coalition</span></li>
<li style="display:flex;gap:12px;align-items:flex-start;font-size:15px;line-height:1.45;color:#1a2236;padding:12px 0;border-bottom:1px solid #e4ebf4;"><span style="flex-shrink:0;width:8px;height:8px;border-radius:50%;background:#2ab5a0;margin-top:7px;"></span><span>Santa Fe Chamber of Commerce</span></li>
</ul>
<p style="font-size:14px;color:#5b647a;line-height:1.6;margin:18px 0 0;">We also partner with The Food Depot, the University of New Mexico, the Unhoused Art Project, Mountain Center (fentanyl testing and Narcan), and Southwest Care (HIV and hepatitis C testing), and coordinate care daily with shelters, clinics, and Christus St. Vincent hospital.</p>
</div>
</div>
</section>

<section id="testimonials" style="background:#f4f7fb;scroll-margin-top:120px;">
<div style="max-width:1200px;margin:0 auto;padding:80px 24px;">
<div style="text-align:center;max-width:640px;margin:0 auto 44px;" data-reveal>
<div style="display:flex;align-items:center;gap:9px;margin-bottom:16px;justify-content:center;">
<span style="width:22px;height:3px;background:#f5b829;border-radius:2px;"></span>
<span style="font-size:12px;letter-spacing:0.18em;text-transform:uppercase;color:#5b647a;font-weight:700;">Testimonials</span>
</div>
<h2 style="font-family:'DM Serif Display',serif;font-size:clamp(32px,4vw,46px);line-height:1.1;margin:0;color:#141f4d;font-weight:400;">In their own words.</h2>
</div>
<div data-reveal style="display:flex;flex-wrap:wrap;background:#ffffff;border-radius:20px;overflow:hidden;box-shadow:0 24px 50px -30px rgba(30,50,120,0.4);margin-bottom:22px;">
<div style="flex:1.2 1 440px;min-width:280px;display:flex;flex-direction:column;">
<div role="img" aria-label="Robert Oliver, April Romero, and Richard Harvey smiling together on a couch at The Life Link" style="flex:1;min-height:320px;background:#1e3278 url('/assets/testimonials/april-richard-robert.jpg') center 40%/cover no-repeat;"></div>
<div style="font-size:12.5px;color:#5b647a;padding:12px 20px;background:#f4f7fb;">Left to right: Robert Oliver, April Romero, and Richard Harvey</div>
</div>
<div style="flex:1 1 380px;min-width:280px;padding:40px 40px 36px;display:flex;flex-direction:column;justify-content:center;gap:26px;">
<div style="display:inline-flex;align-self:flex-start;background:#e9f6f3;color:#1b7c6d;font-size:12px;font-weight:800;letter-spacing:0.08em;text-transform:uppercase;padding:7px 13px;border-radius:999px;">The Clubhouse</div>
<figure style="margin:0;border-left:3px solid #2ab5a0;padding:2px 0 2px 18px;">
<blockquote style="font-family:'DM Serif Display',serif;font-size:clamp(18px,1.7vw,21px);line-height:1.45;color:#1e3278;margin:0 0 10px;font-weight:400;">“I've been with The Life Link a long time, and I enjoy the people and having a safe place to spend my time. The Life Link has given me friends and a place to go. I especially enjoy the computers, painting, and coloring.”</blockquote>
<figcaption style="font-size:12px;letter-spacing:0.1em;text-transform:uppercase;font-weight:700;color:#5b647a;">— April Romero</figcaption>
</figure>
<figure style="margin:0;border-left:3px solid #3a8fd4;padding:2px 0 2px 18px;">
<blockquote style="font-family:'DM Serif Display',serif;font-size:clamp(18px,1.7vw,21px);line-height:1.45;color:#1e3278;margin:0 0 10px;font-weight:400;">“I'm living in my car, and The Life Link gives me a healthy place to spend my time. I'm older and have health issues, and being here helps me take better care of myself and manage my health.”</blockquote>
<figcaption style="font-size:12px;letter-spacing:0.1em;text-transform:uppercase;font-weight:700;color:#5b647a;">— Richard Harvey</figcaption>
</figure>
</div>
</div>
<div style="display:flex;flex-wrap:wrap;gap:22px;margin-bottom:22px;">
<article data-reveal style="flex:1 1 380px;min-width:280px;background:#ffffff;border-radius:20px;overflow:hidden;box-shadow:0 24px 50px -30px rgba(30,50,120,0.4);display:flex;flex-direction:column;">
<div role="img" aria-label="Artist Gloria Mandala seated beside her paintings" style="width:100%;aspect-ratio:3/2;background:#eef2f8 url('/assets/testimonials/gloria-mandala.jpg') center 45%/cover no-repeat;"></div>
<div style="padding:28px 30px 30px;display:flex;flex-direction:column;flex:1;">
<div style="display:inline-flex;align-self:flex-start;background:#fff4dc;color:#966600;font-size:12px;font-weight:800;letter-spacing:0.08em;text-transform:uppercase;padding:7px 13px;border-radius:999px;margin-bottom:16px;">Artist</div>
<div style="font-family:'DM Serif Display',serif;font-size:64px;line-height:0.5;color:#f5b829;height:26px;">“</div>
<blockquote style="font-family:'DM Serif Display',serif;font-size:clamp(19px,1.8vw,22px);line-height:1.45;color:#1e3278;margin:0 0 16px;font-weight:400;flex:1;">The Life Link's art programs give me the opportunity to continue painting in my favorite medium while connecting with others. It's a welcoming, nurturing environment where I feel supported, encouraged, and part of a community.</blockquote>
<div style="font-size:12px;letter-spacing:0.1em;text-transform:uppercase;font-weight:700;color:#5b647a;">— Gloria Mandala</div>
</div>
</article>
<article data-reveal style="flex:1 1 380px;min-width:280px;background:#ffffff;border-radius:20px;overflow:hidden;box-shadow:0 24px 50px -30px rgba(30,50,120,0.4);display:flex;flex-direction:column;">
<div role="img" aria-label="Artist Jeff Ford sketching at a drawing table" style="width:100%;aspect-ratio:3/2;background:#eef2f8 url('/assets/testimonials/jeff-ford.jpg') center 30%/cover no-repeat;"></div>
<div style="padding:28px 30px 30px;display:flex;flex-direction:column;flex:1;">
<div style="display:inline-flex;align-self:flex-start;background:#fff4dc;color:#966600;font-size:12px;font-weight:800;letter-spacing:0.08em;text-transform:uppercase;padding:7px 13px;border-radius:999px;margin-bottom:16px;">Artist</div>
<div style="font-family:'DM Serif Display',serif;font-size:64px;line-height:0.5;color:#f5b829;height:26px;">“</div>
<blockquote style="font-family:'DM Serif Display',serif;font-size:clamp(19px,1.8vw,22px);line-height:1.45;color:#1e3278;margin:0 0 16px;font-weight:400;flex:1;">The Life Link provides a positive, supportive space where I can focus on my art and get away from the distractions of everyday life. Having access to creative activities and being around good people motivates me to keep up in life.</blockquote>
<div style="font-size:12px;letter-spacing:0.1em;text-transform:uppercase;font-weight:700;color:#5b647a;">— Jeff Ford</div>
</div>
</article>
</div>
<div data-reveal style="display:flex;flex-wrap:wrap;background:#ffffff;border-radius:20px;overflow:hidden;box-shadow:0 24px 50px -30px rgba(30,50,120,0.4);margin-bottom:22px;">
<div style="flex:1 1 360px;min-width:280px;min-height:340px;background:#1e3278 url('/assets/photos/08_individual_counseling.jpg') center 30%/cover no-repeat;" role="img" aria-label="A client smiling during a one-on-one session"></div>
<div style="flex:1.3 1 420px;min-width:280px;padding:44px 44px 40px;display:flex;flex-direction:column;justify-content:center;">
<div style="display:inline-flex;align-self:flex-start;background:#e9f6f3;color:#1b7c6d;font-size:12px;font-weight:800;letter-spacing:0.08em;text-transform:uppercase;padding:7px 13px;border-radius:999px;margin-bottom:20px;">Featured Story · Housing</div>
<div style="font-family:'DM Serif Display',serif;font-size:80px;line-height:0.5;color:#f5b829;height:34px;">“</div>
<blockquote style="font-family:'DM Serif Display',serif;font-size:clamp(24px,2.8vw,32px);line-height:1.35;color:#1e3278;margin:0 0 20px;font-weight:400;">I walked in with nothing left. The Life Link didn't just find me housing — they helped me find myself again.</blockquote>
<div style="font-size:14px;color:#5b647a;font-weight:600;">— Program participant, Santa Fe</div>
</div>
</div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,250px),1fr));gap:22px;">
{stories.map((s, s_i) => (<Fragment>
<figure data-reveal style={`margin:0;background:${s.bg};border-radius:16px;padding:30px 26px;display:flex;flex-direction:column;`}>
