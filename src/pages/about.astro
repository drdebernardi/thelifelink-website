</Base>
<script>
  document.querySelectorAll('[data-bio-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const card = btn.closest('.bio-card');
      if (!card) return;
      const open = card.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(open));
    });
  });
</script>
<style is:global>
.bio-card .bio-p{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:5;overflow:hidden;}
.bio-card:not(.open) .bio-more{display:none;}
.bio-card.open .bio-p{display:block;-webkit-line-clamp:unset;}
.bio-card .bio-close{display:none;}
.bio-card.open .bio-close{display:inline;}
.bio-card.open .bio-open{display:none;}

</style>
