---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import data from '../data/home.json';
import { SITE } from '../data/site';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NonProfit',
  name: SITE.name,
  url: SITE.url,
  logo: SITE.url + '/assets/tll-logo.png',
  telephone: '+1-' + SITE.mainPhone.display.replace(/[^0-9]/g, '').replace(/(\d{3})(\d{3})(\d{4})/, '$1-$2-$3'),
  address: { '@type': 'PostalAddress', streetAddress: SITE.address.street, addressLocality: SITE.address.city, addressRegion: SITE.address.region, postalCode: SITE.address.zip, addressCountry: 'US' },
  sameAs: [SITE.social.facebook, SITE.social.instagram, SITE.social.youtube].filter(Boolean),
};
const { chain, trustTiles, services, perYear, clientQuotes, trusted, trust, focus, stats, media, recognition } = data;
---
<Base image="/assets/og/index.jpg" jsonLd={jsonLd} title="The Life Link | Behavioral Health, Housing & Anti-Trafficking Services in Santa Fe" description="The Life Link is a Santa Fe, New Mexico nonprofit providing behavioral health, permanent supportive housing, and anti-human trafficking services, all under one roof for almost 40 years." path="/">

<div style="font-family:'Inter',sans-serif;color:#1a2236;background:#ffffff;overflow-x:hidden;">
<Header active="home" />
<main id="main">

<section style="background:#141f4d;color:#fff;position:relative;overflow:hidden;">
<svg width="760" height="760" viewBox="0 0 760 760" fill="none" aria-hidden="true" style="position:absolute;left:-260px;top:-180px;opacity:0.06;pointer-events:none;"><circle cx="380" cy="380" r="340" stroke="#fff" stroke-width="40"></circle><circle cx="380" cy="380" r="200" stroke="#fff" stroke-width="40"></circle></svg>
<div style="max-width:1280px;margin:0 auto;display:flex;flex-wrap:wrap;align-items:stretch;position:relative;">
<div style="flex:1 1 400px;min-width:300px;padding:64px 40px 60px;display:flex;flex-direction:column;justify-content:center;" data-reveal>
<div style="display:flex;align-items:center;gap:9px;margin-bottom:22px;">
<span style="width:22px;height:3px;background:#f5b829;border-radius:2px;"></span>
<span style="font-size:12px;letter-spacing:0.18em;text-transform:uppercase;color:#a9b7e0;font-weight:700;">Santa Fe, New Mexico · Est. 1987</span>
</div>
<h1 style="font-family:'DM Serif Display',serif;font-weight:400;font-size:clamp(46px,5.6vw,74px);line-height:1.04;margin:0;">
<span style="display:block;color:#ffffff;">One Door.</span>
<span style="display:block;color:#1e7f70;">Connected Care.</span>
<span style="display:block;color:#f5b829;font-style:italic;">A Path Forward.</span>
</h1>
<svg width="240" height="10" viewBox="0 0 240 10" fill="none" aria-hidden="true" style="margin:22px 0 24px;display:block;"><path d="M2 7 C 70 1, 170 1, 238 5" stroke="#2ab5a0" stroke-width="4" stroke-linecap="round"></path></svg>
<p style="font-size:22px;line-height:1.45;color:#ffffff;margin:0;max-width:460px;">One connection can change everything. When every other door has closed, The Life Link <span style="color:#1e7f70;">opens one.</span></p>
</div>
<div style="flex:1.25 1 460px;min-width:300px;padding:48px 32px 48px 8px;display:flex;flex-direction:column;justify-content:center;">
<img src="/assets/photos/04_housing_success.jpg" alt="A smiling man holding up the keys to his new home" style="display:block;width:100%;max-width:560px;aspect-ratio:4/3;object-fit:cover;object-position:center 30%;border-radius:16px;box-shadow:0 30px 60px -24px rgba(0,0,0,0.55);" />
<div style="position:relative;margin:-36px 20px 0 auto;max-width:480px;background:#ffffff;border-left:4px solid #f5b829;border-radius:10px;padding:18px 22px;box-shadow:0 20px 40px -20px rgba(0,0,0,0.5);" data-reveal>
<p style="font-size:clamp(16px,1.5vw,18px);line-height:1.5;color:#1e3278;margin:0;font-weight:500;">The Life Link is not simply another social service agency. It is one of the organizations that holds our community together.</p>
</div>
</div>
</div>
</section>

<section style="background:#f4f7fb;">
<div style="max-width:1200px;margin:0 auto;padding:64px 24px 56px;text-align:center;">
<div data-reveal>
<h2 style="font-family:'DM Serif Display',serif;font-weight:400;font-size:clamp(28px,3.4vw,40px);line-height:1.2;color:#141f4d;margin:0 auto 14px;max-width:760px;">At The Life Link, every service works together so people can rebuild their lives.</h2>
<div style="display:flex;flex-wrap:wrap;justify-content:center;gap:6px 22px;font-size:13px;letter-spacing:0.12em;text-transform:uppercase;font-weight:800;color:#1e7f70;margin-bottom:44px;">
<span>Connected care.</span><span>Complete support.</span><span>All linked.</span><span>Under one roof.</span>
</div>
</div>
<div style="position:relative;" data-reveal>
<div style="position:absolute;left:7%;right:7%;top:39px;height:3px;background:#1e3278;" aria-hidden="true" class="r-lineOpacity"></div>
<div style="position:relative;display:grid;gap:28px 10px;" class="r-svcCols">
{services.map((s, s_i) => (<Fragment>
<div style="display:flex;flex-direction:column;align-items:center;gap:14px;">
<div style={`width:80px;height:80px;border-radius:50%;background:${s.c};display:flex;align-items:center;justify-content:center;box-shadow:0 0 0 6px #f4f7fb;`}>
<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={s.icon}></path></svg>
</div>
<span style="font-size:14px;font-weight:800;letter-spacing:0.04em;text-transform:uppercase;color:#1e3278;line-height:1.25;max-width:130px;">{s.label}</span>
</div>
</Fragment>))}
</div>
</div>
<div style="margin-top:44px;" data-reveal>
<a href="/programs" style="display:inline-flex;align-items:center;gap:8px;background:#1e3278;color:#fff;font-weight:600;font-size:15px;text-decoration:none;padding:13px 24px;border-radius:4px;">Explore all programs <span style="font-size:17px;">→</span></a>
</div>
</div>
</section>

<section style="background:#e6f3f4;color:#141f4d;position:relative;overflow:hidden;">
<svg width="700" height="700" viewBox="0 0 700 700" fill="none" aria-hidden="true" style="position:absolute;right:-220px;top:-260px;opacity:0.07;pointer-events:none;"><circle cx="350" cy="350" r="310" stroke="#1e3278" stroke-width="44"></circle><circle cx="350" cy="350" r="170" stroke="#1e3278" stroke-width="44"></circle></svg>
<div style="max-width:1200px;margin:0 auto;padding:84px 24px;position:relative;">
<div style="text-align:center;max-width:680px;margin:0 auto 48px;" data-reveal>
<div style="display:flex;align-items:center;gap:9px;margin-bottom:16px;justify-content:center;">
<span style="width:22px;height:3px;background:#f5b829;border-radius:2px;"></span>
<span style="font-size:12px;letter-spacing:0.18em;text-transform:uppercase;color:#5b647a;font-weight:700;">Accredited · Licensed · Recognized</span>
</div>
<h2 style="font-family:'DM Serif Display',serif;font-size:clamp(34px,4.4vw,52px);line-height:1.08;margin:0;font-weight:400;">Trusted by Our <span style="color:#1d8575;font-style:italic;">Community.</span></h2>
</div>
<div style="display:grid;gap:22px;margin-bottom:22px;" class="r-badgeCols">
<div data-reveal style="background:#ffffff;border-radius:18px;padding:30px;display:flex;gap:26px;align-items:center;flex-wrap:wrap;box-shadow:0 20px 44px -28px rgba(30,50,120,0.45);">
<img src="/assets/best-of-santa-fe-2026.png" alt="Santa Fe Reporter Best of Santa Fe 2026" style="width:150px;height:150px;object-fit:contain;flex-shrink:0;" />
<div style="flex:1 1 200px;">
<div style="font-size:12px;letter-spacing:0.14em;text-transform:uppercase;color:#d2460f;font-weight:800;margin-bottom:8px;">Santa Fe Reporter · 2026</div>
<div style="font-family:'DM Serif Display',serif;font-size:30px;line-height:1.15;color:#141f4d;margin-bottom:8px;">#1 Best Mental Health Provider</div>
<div style="font-size:14.5px;color:#5b647a;line-height:1.5;">Voted by our neighbors in the Best of Santa Fe awards.</div>
</div>
</div>
<div data-reveal style="background:#ffffff;border-radius:18px;padding:30px;display:flex;gap:26px;align-items:center;flex-wrap:wrap;box-shadow:0 20px 44px -28px rgba(30,50,120,0.45);">
<img src="/assets/carf-accredited.jpeg" alt="CARF Accredited — Aspire to Excellence" style="width:150px;height:150px;object-fit:contain;flex-shrink:0;" />
<div style="flex:1 1 200px;">
<div style="font-size:12px;letter-spacing:0.14em;text-transform:uppercase;color:#2f7abf;font-weight:800;margin-bottom:8px;">International Accreditation</div>
<div style="font-family:'DM Serif Display',serif;font-size:30px;line-height:1.15;color:#141f4d;margin-bottom:8px;">CARF Accredited</div>
<div style="font-size:14.5px;color:#5b647a;line-height:1.5;">Commission on Accreditation of Rehabilitation Facilities.</div>
</div>
</div>
</div>
<div style="display:grid;gap:22px;" class="r-trustCols">
{trustTiles.map((tt, tt_i) => (<Fragment>
<div data-reveal style="background:#ffffff;border-radius:16px;overflow:hidden;display:flex;align-items:stretch;box-shadow:0 16px 36px -28px rgba(30,50,120,0.45);">
<div style={`width:78px;flex-shrink:0;background:${tt.fill};display:flex;align-items:center;justify-content:center;`}>
<svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={tt.icon}></path></svg>
</div>
<div style="padding:22px 22px 22px 20px;">
<div style={`font-size:11.5px;letter-spacing:0.14em;text-transform:uppercase;font-weight:800;color:${tt.c};margin-bottom:6px;`}>{tt.kicker}</div>
<div style="font-family:'DM Serif Display',serif;font-size:24px;line-height:1.15;color:#141f4d;">{tt.big}</div>
<div style="font-size:13.5px;line-height:1.45;color:#5b647a;margin-top:4px;">{tt.txt}</div>
</div>
</div>
</Fragment>))}
</div>
</div>
</section>
</main>
<Footer />
</div>

</Base>
<style is:global>
.r-lineOpacity{opacity:0}
@media (min-width:900px){.r-lineOpacity{opacity:0.9}}
.r-svcCols{grid-template-columns:repeat(2,minmax(0,1fr))}
@media (min-width:560px){.r-svcCols{grid-template-columns:repeat(4,minmax(0,1fr))}}
@media (min-width:900px){.r-svcCols{grid-template-columns:repeat(7,minmax(0,1fr))}}
.r-badgeCols{grid-template-columns:repeat(1,minmax(0,1fr))}
@media (min-width:900px){.r-badgeCols{grid-template-columns:repeat(2,minmax(0,1fr))}}
.r-trustCols{grid-template-columns:repeat(1,minmax(0,1fr))}
@media (min-width:900px){.r-trustCols{grid-template-columns:repeat(3,minmax(0,1fr))}}
</style>
