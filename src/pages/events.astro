---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import data from '../data/events.json';
import newsData from '../data/news.json';
const { stories, staff, board } = data;
const news = newsData.items;
const colors = { navy: ['#1e3278', '#1e3278'], gold: ['#9e6c00', '#c98a00'], green: ['#4d8426', '#5a9a2c'], blue: ['#2f7abf', '#2f7abf'] };
---
<Base image="/assets/og/events.jpg" title="Events & News | The Life Link" description="Events, newsletters, and news from The Life Link in Santa Fe, including updates on Arroyo Chamiso and community gatherings." path="/events">

<div style="font-family:'Inter',sans-serif;color:#1a2236;background:#ffffff;overflow-x:hidden;">
<Header active="events" />
<main id="main">

<section style="background:#141f4d;color:#ffffff;position:relative;overflow:hidden;">
<svg width="700" height="700" viewBox="0 0 700 700" fill="none" aria-hidden="true" style="position:absolute;right:-220px;top:-240px;opacity:0.06;pointer-events:none;"><circle cx="350" cy="350" r="310" stroke="#fff" stroke-width="44"></circle><circle cx="350" cy="350" r="170" stroke="#fff" stroke-width="44"></circle></svg>
<div style="max-width:1200px;margin:0 auto;padding:72px 24px;position:relative;" data-reveal>
<div style="display:flex;align-items:center;gap:9px;margin-bottom:18px;">
<span style="width:22px;height:3px;background:#f5b829;border-radius:2px;"></span>
<span style="font-size:12px;letter-spacing:0.18em;text-transform:uppercase;color:#a9b7e0;font-weight:700;">Events &amp; News</span>
</div>
<h1 style="font-family:'DM Serif Display',serif;font-size:clamp(40px,5.5vw,62px);line-height:1.05;margin:0;font-weight:400;">What's happening at <span style="color:#f5b829;font-style:italic;">The Life Link.</span></h1>
</div>
</section>

<section id="events" style="max-width:1200px;margin:0 auto;padding:76px 24px 40px;scroll-margin-top:120px;">
<div style="margin-bottom:36px;" data-reveal>
<div style="display:flex;align-items:center;gap:9px;margin-bottom:16px;">
<span style="width:22px;height:3px;background:#f5b829;border-radius:2px;"></span>
<span style="font-size:12px;letter-spacing:0.18em;text-transform:uppercase;color:#5b647a;font-weight:700;">Past Events</span>
</div>
<h2 style="font-family:'DM Serif Display',serif;font-size:clamp(30px,4vw,44px);margin:0;color:#141f4d;font-weight:400;">Moments from our community.</h2>
</div>
<div style="display:flex;flex-wrap:wrap;gap:18px;align-items:stretch;">
<div data-reveal style="border-radius:16px;overflow:hidden;background:#eef2f8 url('/assets/events/gala-dinner.jpg') center 50%/cover no-repeat;box-shadow:0 20px 44px -28px rgba(30,50,120,0.5);flex:1 1 300px;min-height:560px;" role="img" aria-label="Three smiling participants at the Rhythms of Recovery Dance-a-Thon photo frame"></div>
<div style="flex:2 1 520px;display:flex;flex-direction:column;gap:18px;">
<div data-reveal style="border-radius:16px;overflow:hidden;background:#eef2f8 url('/assets/events/community-table.jpg') center 40%/cover no-repeat;box-shadow:0 20px 44px -28px rgba(30,50,120,0.5);flex:1 1 auto;min-height:280px;" role="img" aria-label="Guests smiling at a benefit dinner for The Life Link"></div>
<div style="display:flex;flex-wrap:wrap;gap:18px;flex:1 1 auto;">
<div data-reveal style="border-radius:16px;overflow:hidden;background:#eef2f8 url('/assets/events/community-talk.jpg') center 40%/cover no-repeat;box-shadow:0 20px 44px -28px rgba(30,50,120,0.5);flex:1 1 240px;min-height:260px;" role="img" aria-label="An information table from The Life Link at a community event"></div>
<div data-reveal style="border-radius:16px;overflow:hidden;background:#eef2f8 url('/assets/events/dance-a-thon.jpg') center 40%/cover no-repeat;box-shadow:0 20px 44px -28px rgba(30,50,120,0.5);flex:1 1 240px;min-height:260px;" role="img" aria-label="A community gathering listening to a speaker"></div>
</div>
</div>
</div>
</section>

<section style="max-width:1200px;margin:0 auto;padding:20px 24px 76px;">
<div data-reveal style="background:#141f4d;color:#ffffff;border-radius:18px;padding:44px 40px;text-align:center;position:relative;overflow:hidden;">
<svg width="320" height="320" viewBox="0 0 320 320" fill="none" aria-hidden="true" style="position:absolute;right:-90px;top:-110px;opacity:0.08;"><circle cx="160" cy="160" r="135" stroke="#ffffff" stroke-width="30"></circle><circle cx="160" cy="160" r="62" stroke="#ffffff" stroke-width="30"></circle></svg>
<h2 style="font-family:'DM Serif Display',serif;font-weight:400;font-size:clamp(30px,4vw,44px);margin:0;position:relative;">Stay tuned for <span style="color:#f5b829;font-style:italic;">upcoming events.</span></h2>
</div>
</section>

<section id="news" style="background:#f4f7fb;scroll-margin-top:120px;">
<div style="max-width:1200px;margin:0 auto;padding:76px 24px;">
<div style="margin-bottom:36px;" data-reveal>
<div style="display:flex;align-items:center;gap:9px;margin-bottom:16px;">
<span style="width:22px;height:3px;background:#f5b829;border-radius:2px;"></span>
<span style="font-size:12px;letter-spacing:0.18em;text-transform:uppercase;color:#5b647a;font-weight:700;">In the News</span>
</div>
<h2 style="font-family:'DM Serif Display',serif;font-size:clamp(30px,4vw,44px);margin:0;color:#141f4d;font-weight:400;">The Life Link in the press.</h2>
</div>
<div style="display:grid;gap:20px;" class="r-newsCols">
{news.map((n, n_i) => { const [c, fill] = colors[n.color] ?? colors.navy; const bgImg = n.image ? `url('${n.image}')` : 'none'; return (<Fragment>
<a data-reveal href={n.url} target="_blank" rel="noopener" style="background:#ffffff;border-radius:16px;overflow:hidden;text-decoration:none;display:flex;flex-direction:column;box-shadow:0 16px 36px -28px rgba(30,50,120,0.45);">
<div role="img" aria-label={n.title} style={`width:100%;aspect-ratio:16/9;background-color:${fill};background-image:${bgImg};background-size:cover;background-position:center;border-bottom:4px solid ${fill};`}></div>
<div style="padding:24px 26px 24px;display:flex;flex-direction:column;justify-content:space-between;gap:22px;flex:1;">
<div>
<div style={`font-size:12px;letter-spacing:0.14em;text-transform:uppercase;color:${c};font-weight:800;margin-bottom:12px;`}>{n.outlet}</div>
<h3 style="font-family:'DM Serif Display',serif;font-weight:400;font-size:23px;line-height:1.25;color:#141f4d;margin:0;">{n.title}</h3>
</div>
<span style="font-size:14px;font-weight:700;color:#1e3278;">Read the article →</span>
</div>
</a>
</Fragment>); })}
</div>
</div>
</section>
</main>
<Footer />
</div>

</Base>
<style is:global>
.r-newsCols{grid-template-columns:repeat(1,minmax(0,1fr))}
@media (min-width:640px){.r-newsCols{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (min-width:1100px){.r-newsCols{grid-template-columns:repeat(4,minmax(0,1fr))}}
</style>
