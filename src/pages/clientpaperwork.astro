---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
// HIDDEN PAGE. Reached only by the QR code on printed handouts (https://www.thelifelink.org/clientpaperwork).
// Not in the menu, footer or sitemap, and marked noindex. Do not link to it from other pages.
// The PDFs live in public/assets/docs/. To update, replace the files with the same names.
const groups = [
  {
    lang: 'en',
    title: 'Client Handbook and Consents',
    intro: 'Please read the handbook. The consent forms are also included here.',
    docs: [
      { label: 'Client Handbook', href: '/assets/docs/client-handbook-en.pdf' },
      { label: 'Client Consents', href: '/assets/docs/client-consents-en.pdf' },
    ],
  },
  {
    lang: 'es',
    title: 'Manual del Cliente y Consentimientos',
    intro: 'Por favor lea el manual. Los formularios de consentimiento también están incluidos aquí.',
    docs: [
      { label: 'Manual del Cliente', href: '/assets/docs/client-handbook-es.pdf' },
      { label: 'Consentimientos del Cliente', href: '/assets/docs/client-consents-es.pdf' },
    ],
  },
];
---
<Base title="Client Paperwork | The Life Link" description="Client handbook and consent forms for The Life Link, in English and Spanish." path="/clientpaperwork" noindex={true}>
<div style="font-family:'Inter',sans-serif;color:#1a2236;background:#ffffff;overflow-x:hidden;">
<Header active="" />
<main id="main">
<section style="max-width:820px;margin:0 auto;padding:72px 24px 88px;">
<div style="display:flex;align-items:center;gap:9px;margin-bottom:20px;">
<span style="width:22px;height:3px;background:#f5b829;border-radius:2px;"></span>
<span style="font-size:12px;letter-spacing:0.18em;text-transform:uppercase;color:#5b647a;font-weight:700;">Client Paperwork</span>
</div>
<h1 style="font-family:'DM Serif Display',serif;font-size:clamp(36px,5vw,56px);line-height:1.08;margin:0 0 32px;color:#141f4d;font-weight:400;">Welcome to The Life Link</h1>
{groups.map((g) => (
<div lang={g.lang} style="margin:0 0 44px;">
<h2 style="font-family:'DM Serif Display',serif;font-size:clamp(26px,3.4vw,34px);line-height:1.15;margin:0 0 10px;color:#141f4d;font-weight:400;">{g.title}</h2>
<p style="font-size:17px;line-height:1.65;color:#3d4660;margin:0 0 20px;">{g.intro}</p>
<div style="display:flex;flex-wrap:wrap;gap:14px;">
{g.docs.map((d) => (
<a href={d.href} target="_blank" rel="noopener" style="background:#1e3278;color:#ffffff;font-weight:700;font-size:15.5px;text-decoration:none;padding:14px 26px;border-radius:4px;">{d.label} (PDF)</a>
))}
</div>
</div>
))}
<p style="font-size:16px;line-height:1.65;color:#3d4660;margin:0;">Questions? Preguntas? <a href="tel:+15054380010" style="color:#1e3278;font-weight:700;">(505) 438-0010</a></p>
</section>
</main>
<Footer />
</div>
</Base>
