---
import { NAV, SITE } from '../data/site';
const { active = '' } = Astro.props;
---
<header class="tll-head">
  <div class="tll-top">
    After-Hours: Call <a href="tel:988">988</a> for Mental Health &amp; Substance Abuse Crises&nbsp;&nbsp;|&nbsp;&nbsp;Call <a href="tel:911">911</a> for Medical Emergencies
  </div>
  <div class="tll-bar">
    <div class="tll-bar-in">
      <a href="/" class="tll-logo"><img src="/assets/tll-logo.png" alt="The Life Link" width="104" height="52"></a>
      <nav class="tll-desk" aria-label="Main">
        {NAV.map((item) => (
          <div class="tll-item">
            <a href={item.href} class={'tll-link' + (item.key === active ? ' on' : '')}>{item.label}{item.subs && (<svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true" style="margin-left:6px;vertical-align:middle;"><path d="M2 3.5l3 3 3-3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>)}</a>
            {item.subs && (
              <div class="tll-sub"><div class="tll-sub-in">
                {item.subs.map((s) => (<a href={s.href} target={s.external ? '_blank' : undefined} rel={s.external ? 'noopener' : undefined}>{s.label}</a>))}
              </div></div>
            )}
          </div>
        ))}
      </nav>
      <div class="tll-cta"><a href={SITE.donateUrl} target="_blank" rel="noopener" class="tll-donate">Donate</a></div>
      <button class="tll-burger" id="tll-burger" aria-label="Menu" aria-expanded="false" aria-controls="tll-mobile"><span></span><span></span><span></span></button>
    </div>
    <div class="tll-mobile" id="tll-mobile" hidden>
      <nav aria-label="Mobile">
        {NAV.map((item) => (
          <Fragment>
            <a href={item.href} class={'tll-m' + (item.key === active ? ' on' : '')}>{item.label}</a>
            {item.subs && item.subs.map((s) => (<a href={s.href} class="tll-ms" target={s.external ? '_blank' : undefined} rel={s.external ? 'noopener' : undefined}>{s.label}</a>))}
          </Fragment>
        ))}
      </nav>
      <div class="tll-mcta">
        <a href="/programs#get-help" class="tll-mhelp">Get Help</a>
        <a href={SITE.donateUrl} target="_blank" rel="noopener" class="tll-mdon">Donate</a>
      </div>
    </div>
  </div>
</header>
<style is:global>
  .tll-head{font-family:'Inter',sans-serif;position:sticky;top:0;z-index:100;}
  .tll-top{background:#141f4d;color:#c9d2ea;font-size:12.5px;letter-spacing:0.01em;text-align:center;padding:8px 16px;line-height:1.5;}
  .tll-top a{color:#f5b829;font-weight:700;text-decoration:none;}
  .tll-bar{background:#fff;border-bottom:1px solid #e4ebf4;}
  .tll-bar-in{max-width:1440px;margin:0 auto;padding:14px 24px;display:flex;align-items:center;justify-content:space-between;gap:20px;}
  .tll-logo{display:flex;align-items:center;gap:11px;text-decoration:none;flex-shrink:0;}
  .tll-logo img{height:38px;width:auto;display:block;}
  .tll-desk{display:flex;align-items:center;gap:8px;flex-wrap:nowrap;}
  .tll-item{position:relative;}
  .tll-link{color:#1a2236;text-decoration:none;font-weight:600;font-size:12px;padding-bottom:3px;border-bottom:2px solid transparent;white-space:nowrap;}
  .tll-link.on{color:#1e3278;border-bottom-color:#f5b829;}
  .tll-sub{display:none;position:absolute;top:100%;left:-14px;padding-top:12px;z-index:200;}
  .tll-item:hover .tll-sub,.tll-item:focus-within .tll-sub{display:block;}
  .tll-sub-in{background:#fff;border:1px solid #e4ebf4;border-top:3px solid #f5b829;border-radius:10px;box-shadow:0 18px 40px -16px rgba(20,31,77,0.35);padding:8px;min-width:190px;display:flex;flex-direction:column;}
  .tll-sub-in a{color:#1a2236;text-decoration:none;font-size:14.5px;font-weight:600;padding:10px 12px;border-radius:6px;white-space:nowrap;}
  .tll-sub-in a:hover,.tll-sub-in a:focus{color:#1e3278;background:#f4f7fb;}
  .tll-cta{display:flex;align-items:center;gap:10px;flex-shrink:0;}
  .tll-donate{background:#f5b829;color:#141f4d;font-weight:700;font-size:14px;text-decoration:none;padding:10px 18px;border-radius:4px;}
  .tll-burger{display:none;background:none;border:none;cursor:pointer;padding:6px;flex-direction:column;gap:5px;}
  .tll-burger span{width:26px;height:2.5px;background:#1e3278;border-radius:2px;display:block;}
  .tll-mobile{border-top:1px solid #e4ebf4;background:#fff;padding:14px 24px 22px;}
  .tll-mobile[hidden]{display:none;}
  .tll-mobile nav{display:flex;flex-direction:column;gap:4px;}
  .tll-m{color:#1a2236;text-decoration:none;font-weight:600;font-size:17px;padding:11px 4px;border-bottom:1px solid #f4f7fb;}
  .tll-m.on{color:#1e3278;}
  .tll-ms{color:#5b647a;text-decoration:none;font-weight:600;font-size:15px;padding:9px 4px 9px 20px;border-bottom:1px solid #f4f7fb;}
  .tll-mcta{display:flex;gap:10px;margin-top:16px;}
  .tll-mhelp,.tll-mdon{flex:1;text-align:center;font-size:15px;text-decoration:none;padding:13px 16px;border-radius:4px;}
  .tll-mhelp{background:#2ab5a0;color:#fff;font-weight:600;}
  .tll-mdon{background:#f5b829;color:#141f4d;font-weight:700;}
  @media (min-width:1140px){.tll-logo img{height:52px;}.tll-desk{gap:14px;}.tll-link{font-size:13.5px;}}
  @media (min-width:1340px){.tll-desk{gap:22px;}.tll-link{font-size:15px;}}
  @media (max-width:979px){.tll-desk,.tll-cta{display:none;}.tll-burger{display:flex;}}
  @media (min-width:980px){.tll-mobile{display:none !important;}}
</style>
<script>
  const b = document.getElementById('tll-burger');
  const p = document.getElementById('tll-mobile');
  if (b && p) b.addEventListener('click', () => { const open = p.hasAttribute('hidden'); if (open) p.removeAttribute('hidden'); else p.setAttribute('hidden', ''); b.setAttribute('aria-expanded', String(open)); });
</script>
